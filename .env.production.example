# PostgreSQL
DATABASE_URL=postgresql://ree_user:CHANGE_ME@localhost:5432/ree_auditor?schema=public

# API
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://intranet-ree-auditor
DATA_DIR=D:\ree-auditor\data
UPLOAD_TMP_DIR=D:\ree-auditor\data\tmp\uploads

# Frontend build
VITE_API_URL=http://intranet-ree-auditor:3000

# ESIOS
ESIOS_API_URL=https://api.esios.ree.es
ESIOS_API_TOKEN=
ESIOS_TIMEOUT_SECONDS=60
ESIOS_RETRIES=2

# OMIE SIOM2
OMIE_SIOM2_ENDPOINT=https://www.mercado.omie.es/jsiom/webServices/SIOMServiceRouter
OMIE_SIOM2_P12_PATH=D:\ree-auditor\certs\omie-siom2.p12
OMIE_SIOM2_P12_HOST_PATH=D:\ree-auditor\certs\omie-siom2.p12
OMIE_SIOM2_P12_BASE64=
OMIE_SIOM2_P12_PASSPHRASE=
OMIE_SIOM2_REJECT_UNAUTHORIZED=true
OMIE_SIOM2_DNS_SERVERS=1.1.1.1,8.8.8.8
OMIE_SIOM2_TIMEOUT_MS=30000

# REE/eSIOS private participa
REE_ESIOS_PRIVATE_ENABLED=false
REE_ESIOS_PRIVATE_URL=https://participa.esios.ree.es/ServicioSM/ServiceEME
REE_ESIOS_PRIVATE_P12_PATH=D:\ree-auditor\certs\omie-siom2.p12
REE_ESIOS_PRIVATE_P12_BASE64=
REE_ESIOS_PRIVATE_P12_PASSWORD=
REE_ESIOS_PRIVATE_TIMEOUT_MS=30000
REE_ESIOS_PRIVATE_REJECT_UNAUTHORIZED=true

# OMIE data/cache paths
OMIE_CATALOGO_PATH=D:\ree-auditor\data\omie-catalogo.json
OMIE_CATALOGO_ANALIZADO_PATH=D:\ree-auditor\data\omie-catalogo-analizado.json
OMIE_CATALOGO_PRIORIDADES_PATH=D:\ree-auditor\data\omie-catalogo-prioridades.json
OMIE_PRECIOS_PROGRAMAS_PATH=D:\ree-auditor\data\omie-precios-informe.json
OMIE_PRECIOS_MERCADO_REPORT_PATH=D:\ree-auditor\data\omie-precios-mercado-report.json
OMIE_CUARTOHORARIO_PATH=D:\ree-auditor\data\omie-cuartohorario-report.json
OMIE_DESCARGAS_PDBC_REPORT_PATH=D:\ree-auditor\data\omie-descargas-pdbc-report.json
OMIE_DIAGNOSTICO_ENERGIA_PATH=D:\ree-auditor\data\omie-diagnostico-energia.json
OMIE_DIAGNOSTICO_ENERGIA_PRUEBAS_PATH=D:\ree-auditor\data\omie-pruebas
OMIE_ENERGIA_PHF_SESIONES=01,02,03,04,05,06,07
